APP_NAME=zhixue-backend
DEBUG=true
API_V1_PREFIX=/api/v1

# docker compose PG maps host 5435 → container 5432
DATABASE_URL=postgresql+asyncpg://zhixue:zhixue_dev@localhost:5435/zhixue
REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio_dev_secret
S3_BUCKET=zhixue-media

# Auth (WeChat mini-program ship gate) — never commit real secrets
AUTH_REQUIRED=true
AUTH_DEV_LOGIN=true
WECHAT_APP_ID=
WECHAT_APP_SECRET=
SESSION_TTL_SECONDS=604800

# Upload limits (default 512 MiB; override as needed)
UPLOAD_MAX_BYTES=536870912
UPLOAD_ALLOWED_CONTENT_TYPES=video/mp4,audio/mpeg,audio/wav,audio/x-wav,image/png,image/jpeg,application/pdf

# MinIO timeouts (V-P0-4)
S3_CONNECT_TIMEOUT_SECONDS=5
S3_READ_TIMEOUT_SECONDS=120

# ASR reproducibility (V-P0-1) — set true for eval/regression baselines
ASR_REPRODUCIBLE=false
ASR_CPU_THREADS=0

# Job fail → empty timeline (false). Demo-only fixture on fail: true
TIMELINE_FIXTURE_ON_JOB_FAIL=false

# V-P1 ASR accuracy
ASR_AUDIO_PREPROCESS=true
ASR_HIGHPASS_HZ=80
ASR_LOUDNORM=true
ASR_INITIAL_PROMPT=数据库 关系模型 Ted Codd 指针 耦合度 增删改查 浏览器 模块 面向对象
ASR_MODEL_SHORT=small
ASR_MODEL_LONG=base
ASR_LONG_THRESHOLD_SEC=480
ASR_COMPRESSION_RATIO_WARN=2.35
ASR_NO_SPEECH_PROB_WARN=0.9
