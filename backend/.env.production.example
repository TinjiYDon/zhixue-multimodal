APP_NAME=zhixue-backend
DEBUG=false
API_V1_PREFIX=/api/v1

# Replace these with production service addresses.
DATABASE_URL=postgresql+asyncpg://<db_user>:<db_password>@<db_host>:5432/<db_name>
REDIS_URL=redis://<redis_host>:6379/0

# Replace these with production object storage values.
S3_ENDPOINT=https://<object-storage-endpoint>
S3_ACCESS_KEY=<s3_access_key>
S3_SECRET_KEY=<s3_secret_key>
S3_BUCKET=zhixue-media

# B1 Auth: production must use real WeChat code2session.
AUTH_REQUIRED=true
AUTH_DEV_LOGIN=false
WECHAT_APP_ID=<wechat_app_id>
WECHAT_APP_SECRET=<wechat_app_secret>
SESSION_TTL_SECONDS=604800

# Upload limits. Tune before launch if product policy changes.
UPLOAD_MAX_BYTES=209715200
UPLOAD_ALLOWED_CONTENT_TYPES=video/mp4,audio/mpeg,audio/wav,audio/x-wav,image/png,image/jpeg,application/pdf
